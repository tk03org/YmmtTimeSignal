<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net48</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <AssemblyName>YmmtTimeSignal</AssemblyName>
    <RootNamespace>YmmtTimeSignal</RootNamespace>
    <LangVersion>latest</LangVersion>
    <PlatformTarget>AnyCPU</PlatformTarget>
    <OutputPath>..\..\bin\</OutputPath>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
    <Deterministic>true</Deterministic>
  </PropertyGroup>

  <ItemGroup>
    <Reference Include="System.Runtime.Serialization" />
  </ItemGroup>

  <Target Name="CopyToRoot" AfterTargets="Build">
    <Copy SourceFiles="$(OutputPath)$(AssemblyName).exe" DestinationFolder="$(MSBuildProjectDirectory)\..\..\" SkipUnchangedFiles="true" />
  </Target>

</Project>
